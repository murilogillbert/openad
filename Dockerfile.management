# Imagem de produção do portal (`openad-management`).
#
# O portal é Angular com SSR configurado, mas esta imagem serve **estático**, e isso é uma
# decisão: o portal é uma ferramenta interna atrás de login, sem nada a indexar e sem ganho de
# primeiro byte que justifique manter um processo Node por réplica. A VPS tem 2 vCPU e
# ~4 GB livres, e Mongo, Redis e RabbitMQ ainda vão entrar — um processo SSR a menos é
# memória que sobra para o que não tem alternativa.
#
# Consequência que precisa ser respeitada: as variáveis `EXPO_PUBLIC`-like do Angular são
# embutidas no bundle em tempo de **build**. Trocar a URL da API exige imagem nova, não
# reinício. O `environment.prod.ts` é o lugar onde isso é definido.

# ---------------------------------------------------------------------------------------
# Estágio 1 — build
# ---------------------------------------------------------------------------------------
FROM node:22-alpine AS build

RUN apk add --no-cache libc6-compat
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN corepack install && pnpm install --frozen-lockfile

COPY . .

# A URL da API é **embutida no bundle**, não lida em tempo de execução: o
# `@ngx-env/builder` substitui `process.env['API_BASE_URL']` por literal durante a compilação
# (ver `src/environments/environment.ts`, que lança se a variável faltar — e foi o que
# derrubou o primeiro build desta imagem).
#
# Consequência prática que precisa ser respeitada: apontar o portal para outra API exige
# **imagem nova**, não reinício nem troca de variável no painel. É a mesma restrição que o
# `EXPO_PUBLIC_*` impõe aos aplicativos do ecossistema.
ARG API_BASE_URL=https://adsapi.opendriver.com.br/api/v1
ENV API_BASE_URL=${API_BASE_URL}

# `NODE_OPTIONS` com heap maior: o build do Angular 21 com AOT passa de 2 GB em pico, e o
# padrão do Node 22 num contêiner não é suficiente — a falha aparece como "JavaScript heap out
# of memory" no meio da compilação, sem apontar o arquivo.
ENV NODE_OPTIONS=--max-old-space-size=3584
RUN pnpm exec nx run openad-management:build --skip-nx-cache

# ---------------------------------------------------------------------------------------
# Estágio 2 — runtime
# ---------------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

RUN apk add --no-cache curl

# O build do Angular 21 com `outputMode` estático deposita o navegador em `browser/`.
COPY --from=build /app/dist/app/openad-management/browser /usr/share/nginx/html

COPY infra/nginx/openad-management.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1/ >/dev/null || exit 1
