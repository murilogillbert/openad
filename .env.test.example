# Used by Jest / integration tests only. The API test harness also sets many of these in code;
# copy to `.env.test` only if you override defaults (e.g. point at Docker Mongo/Redis).

# Mongo: unset = mongodb-memory-server; or set host (with Docker auth: include user/pass + authSource=admin)
# MONGO_TEST_URI=mongodb://openad:openad-dev-mongo@127.0.0.1:27017/?authSource=admin
# MONGO_TEST_USE_MEMORY=false

# Redis: real instance (Docker). Override if not on localhost:6379
# REDIS_TEST_URI=redis://127.0.0.1:6379
# Or rely on REDIS_URL from .env / compose (same as openad-api)

# MQTT for suites that hit a real broker
MQTT_TEST_URI=mqtt://openad:openad-dev-mqtt@127.0.0.1:1884

# Optional ACL integration (needs broker matching test expectations)
# MQTT_ACL_TEST=true

# Asset integrity job uses the same flag name in upload service
# SYNC_ASSET_VERIFY_IN_TESTS=true
