{
  "name": "openad-monorepo",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "docker:up": "bash scripts/with-monorepo-env.sh root -- docker compose up -d",
    "docker:down": "bash scripts/with-monorepo-env.sh root -- docker compose down",
    "docker:logs": "bash scripts/with-monorepo-env.sh root -- docker compose logs -f",
    "docker:ps": "bash scripts/with-monorepo-env.sh root -- docker compose ps",
    "docker:reset": "bash scripts/with-monorepo-env.sh root -- docker compose down --remove-orphans && bash scripts/with-monorepo-env.sh root -- docker compose up -d",
    "docker:reset:volumes": "bash scripts/with-monorepo-env.sh root -- docker compose down -v --remove-orphans && bash scripts/with-monorepo-env.sh root -- docker compose up -d",
    "api:test": "NODE_ENV=test bash scripts/with-monorepo-env.sh app openad-api -- pnpm exec nx run openad-api:test",
    "api:serve": "bash scripts/with-monorepo-env.sh app openad-api -- pnpm exec nx run openad-api:serve --skip-nx-cache",
    "api:seed": "bash scripts/with-monorepo-env.sh app openad-api -- pnpm exec nx run openad-api:seed",
    "client:android:sync": "bash scripts/with-monorepo-env.sh app openad-ad-client -- pnpm exec nx run openad-ad-client:cap-sync",
    "client:android:build": "bash scripts/with-monorepo-env.sh app openad-ad-client -- pnpm exec nx run openad-ad-client:cap-sync && bash scripts/with-monorepo-env.sh app openad-ad-client -- pnpm exec nx run openad-ad-client:cap-build-android",
    "management:serve": "bash scripts/with-monorepo-env.sh app openad-management -- pnpm exec nx run openad-management:serve --skip-nx-cache",
    "e2e:management": "NODE_ENV=test bash scripts/with-monorepo-env.sh app openad-management -- pnpm exec nx run openad-management-e2e:e2e",
    "storage:init-media-bucket": "node scripts/init-media-bucket.mjs",
    "minio:init-media-bucket": "node scripts/init-media-bucket.mjs"
  },
