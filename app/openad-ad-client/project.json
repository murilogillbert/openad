{
  "name": "openad-ad-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "app/openad-ad-client/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/app/openad-ad-client",
        "browser": "app/openad-ad-client/src/main.ts",
        "tsConfig": "app/openad-ad-client/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "app/openad-ad-client/public"
          },
          {
            "glob": "**/*",
            "input": "app/openad-ad-client/capacitor/assets/factory-default-ads",
            "output": "factory-default-ads"
          }
        ],
        "styles": ["app/openad-ad-client/src/styles.css"],
        "server": "app/openad-ad-client/src/main.server.ts",
        "ssr": {
          "entry": "app/openad-ad-client/src/server.ts"
        },
        "outputMode": "server"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "define": {
            "__OPENAD_API_BASE_URL__": "\"https://adsapi.opendriver.com.br/api/v1\"",
            "__OPENAD_MQTT_URL__": "\"\""
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "define": {
            "__OPENAD_API_BASE_URL__": "\"http://10.0.2.2:3000/api/v1\"",
            "__OPENAD_MQTT_URL__": "\"\""
          }
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "openad-ad-client:build:production"
        },
        "development": {
          "buildTarget": "openad-ad-client:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "openad-ad-client:build",
        "port": 4200,
        "staticFilePath": "dist/app/openad-ad-client/browser",
        "spa": true
      }
    },
    "cap-sync": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/cap-sync.mjs"
      }
    },
    "cap-build-android": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/gradle-android.mjs assembleDebug"
      }
    }
  }
}
