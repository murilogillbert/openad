MONGO_URI=mongodb://openad:openad-dev-mongo@127.0.0.1:27017/openad?authSource=admin
MONGOOSE_AUTO_INDEX=true
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PORT=3000
MQTT_URL=mqtt://openad:openad-dev-mqtt@127.0.0.1:1884
MQTT_MANAGEMENT_URL=http://127.0.0.1:15672
MQTT_MANAGEMENT_USER=openad
MQTT_MANAGEMENT_PASSWORD=openad-dev-mqtt
RABBITMQ_PROVISION_DEVICE_MQTT_USERS=true
RABBITMQ_MQTT_VHOST=/
RABBITMQ_MQTT_EXCHANGE=amq.topic
S3_REGION=us-east-1
S3_BUCKET=openad-media
# MinIO default credentials (see scripts/minio-init-media-bucket.sh; docker-compose minio service)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
ASSET_URL_SIGNING_SECRET=change-me-asset-url-signing-secret
REPORT_EXPORT_RETENTION_DAYS=30
SCREENSHOT_RETENTION_DAYS=14
PAIRING_SECRET_TTL_MS=600000
SKIP_ASSET_ROTATION=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=P@ssw0rd
POWER_ENGINE_OFF_VOLTAGE_V=12
POWER_ENGINE_OFF_GRACE_MS=30000
# Fleet, media limits, analytics, and fraud: Settings → Platform in the admin app (not env).
MEDIA_VFS_TENANT_KEY_PREFIX=openad
MEDIA_UPLOAD_SESSION_TTL_SECONDS=3600
MEDIA_ALLOWED_MIME_TYPES=video/mp4,image/jpeg,image/png
DOOH_RULESET_VERSION=2026.1
MEDIA_VFS_DEDUP=false