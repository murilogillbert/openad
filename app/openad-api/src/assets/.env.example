# Example env fragment for openad-api (copy patterns to `app/openad-api/.env*`).
# See repo root `.env.example` for the full stack.

# MONGO_URI=mongodb://openad:openad-dev-mongo@127.0.0.1:27017/openad?authSource=admin

# Fleet / media / analytics / fraud: configure via admin app Settings → Platform (Mongo), not env.
# POWER_ENGINE_OFF_VOLTAGE_V=12
# POWER_ENGINE_OFF_GRACE_MS=30000

# Optional: media storage KPI percent bar (sum of MediaAsset.fileSize vs this quota, bytes).
# DASHBOARD_MEDIA_STORAGE_QUOTA_BYTES=2147483648000
