{
  "name": "openad-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "app/openad-api/src",
  "projectType": "app/openad-apilication",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "app/openad-api"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/app/openad-api/package.json",
        "{workspaceRoot}/dist/app/openad-api/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/app/openad-api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "openad-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "openad-api:build:development"
        },
        "production": {
          "buildTarget": "openad-api:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "app/openad-api/jest.config.cts",
        "passWithNoTests": false,
        "runInBand": true
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec ts-node -P app/openad-api/tsconfig.app.json app/openad-api/scripts/generate-openapi.ts"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm exec ts-node -P app/openad-api/tsconfig.app.json app/openad-api/scripts/seed-admin.ts"
      }
    }
  }
}
